luengo":{"bio":{"ca":"Victoria Luengo més coneguda com a Vicky Luengo (Palma, 7 d'abril de 1990) és una actriu nascuda a Mallorca, que va viure a Barcelona dels 4 als 18 anys. Va començar a fer teatre com a activitat extraescolar alhora que estudiava educació primària. Més tard va estar en una escola d'interpretació especialitzada (Escola Memory, a Barcelona). La primera vegada que va pujar a l'escenari de manera professional va ser amb 14 anys. El 2015 va ser guardonada al Festival Internacional de Cinema de la Ciutat de Nova York com a millor actiu principal en la pel·lícula Born de Claudio Zulian. El 2023 va ser guardonada amb el premi Gaudí a la millor actriu protagonista."},"conocida":[["Hogar",2020,"pelicula","Natalia"],["La habitación de al lado",2024,"pelicula","Fred's Wife"],["Las leyes de la termodinámica",2018,"pelicula","Eva"],["Antidisturbios",2020,"serie","Laia Urquijo"],["Amarga Navidad",2026,"pelicula","Patricia"],["Reina roja",2024,"serie","Antonia Scott"]],"descripcion":{"ca":"actriu mallorquina","es":"actriz española"},"foto":"https://image.tmdb.org/t/p/w185/sITOSQWB4nzQJUfrC5Fpx1jY8E5.jpg","lugar":"Palma, Mallorca, Balearic Islands, Spain","nacimiento":"1990-04-07","nombre":"Victoria Luengo","oficio":"Acting","tmdb":1208946,"wikidata":"Q6161447","wikipedia":"https://es.wikipedia.org/wiki/Vicky_Luengo"},"n-xavi-saez":{"conocida":[["La casa de papel",2017,"serie","Policía"],["Dolor y gloria",2019,"pelicula","Man at Cinema"],["El inocente",2021,"serie","Ibai Sáez"],["Las leyes de la frontera",2021,"pelicula","Hidalgo"],["Modelo 77",2022,"pelicula","Boni"],["La última noche en Tremor",2024,"serie","ricardo"]],"descripcion":{"es":"actor español","ca":"actor català"},"foto":"https://image.tmdb.org/t/p/w185/y8TEc4i2sdERhtXjYDTT5jnakiI.jpg","nacimiento":"1975-01-01","nombre":"Xavi Sáez","oficio":"Acting","tmdb":2270206,"wikidata":"Q107656777"},"n-marti-cordero":{"conocida":[["Olympo",2025,"serie","Charly Lago"],["Viaje de fin de curso: Mallorca",2025,"pe